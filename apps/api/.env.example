# ---------------------------------------------------------------------------
# D-Trace API environment
#
# Copy to `.env` and fill in. `src/config/env.schema.ts` validates every value
# at boot: a missing or too-short secret stops the process instead of silently
# weakening the system.
#
# Generate each secret separately (never reuse one for two purposes):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# '::' listens on both IPv6 and IPv4. Use 127.0.0.1 to keep the API off the network.
HOST=::
APP_NAME="D-Trace API"
API_PREFIX=api
API_VERSION=1

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://dtrace:dtrace@localhost:5432/dtrace?schema=public"

# --- CORS ------------------------------------------------------------------
# Comma-separated, exact origins only. Wildcards are not supported on purpose.
CORS_ORIGINS=http://localhost:3000

# --- Tokens ----------------------------------------------------------------
# Minimum 32 characters each, and they MUST differ from one another.
# JWT_REFRESH_SECRET doubles as the HMAC pepper for stored refresh tokens:
# rotating it invalidates every existing session.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=dtrace
JWT_AUDIENCE=dtrace-web

# --- Cookies ---------------------------------------------------------------
COOKIE_SECRET=replace-me-with-a-third-48-byte-random-string
SETTINGS_SECRET=replace-me-with-a-fourth-48-byte-random-string
# Leave COOKIE_DOMAIN unset unless the API and web app share a parent domain.
# COOKIE_DOMAIN=.dtrace.example
COOKIE_SAME_SITE=lax

# --- Brute-force protection ------------------------------------------------
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Rate limiting ---------------------------------------------------------
# THROTTLE_LIMIT is per authenticated user (UserThrottlerGuard keys on the user
# id), so one busy session cannot exhaust everyone else's budget. A single page
# render legitimately makes several calls, so keep this generous.
# Credential routes (login, register, refresh, change-password) carry their own
# far tighter limits, declared with @Throttle at the route itself.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- Runtime ---------------------------------------------------------------
# Enable ONLY when the app sits behind a proxy you control (it trusts X-Forwarded-For).
TRUST_PROXY=false
BODY_LIMIT=1mb
# Uploaded document files. The directory is created on first write.
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=15728640
LOG_LEVEL=debug
# Must be false in production; the config layer enforces this.
SWAGGER_ENABLED=true

# --- Seeding ---------------------------------------------------------------
# Used by `npm run db:seed`. There is no default admin password by design.
SEED_ADMIN_EMAIL=admin@dtrace.local
SEED_ADMIN_PASSWORD=ChangeMeLocally123!
