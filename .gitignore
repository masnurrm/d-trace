# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
.next/
.next.stale-*/
out/
*.tsbuildinfo
next-env.d.ts

# generated
apps/api/src/generated/
coverage/
.nyc_output/

# env — NEVER commit real secrets
.env
.env.*
!.env.example
!.env.*.example

# logs
*.log
npm-debug.log*
logs/

# editor / os
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo

# Office lock files (created while a .docx/.xlsx/.html is open elsewhere)
~$*

# caches
.turbo/
.eslintcache
.cache/

# Uploaded document files; content, never source.
apps/api/storage/

# deploy/docker — generated at setup time: secrets, certs, resolved nginx
# config. The Dockerfiles, docker-compose.yml and the two setup/redeploy
# scripts themselves ARE tracked (not covered by these).
deploy/docker/env/
deploy/docker/certs/
deploy/docker/nginx/conf.d/
